{
  "name": "magpie-plugin-today-auth",
  "version": "0.1.4",
  "description": "Today AI (todayai.cn) for magpie: 手机号验证码 / Cookie 登录，按账号的档位目录，每个 magpie session 一条独立的 Today 会话，支持图片附件，套餐与额度上报。",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "CHANGELOG.md",
    "registry-entry.json",
    "assets",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "provider",
    "today",
    "todayai",
    "opencode"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e.mock.test.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "probe": "node tests/probe-live.mjs"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 2,
    "name": "Today AI"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpie-community/plugins.git"
  }
}
